[Unit]
Description=Mood Pattern Diary local inference worker
After=network.target mood-pattern-diary.service

[Service]
Type=simple
WorkingDirectory=/home/epalk/projects/diary-website/backend
EnvironmentFile=/home/epalk/.config/mood-pattern-diary/service.env
Environment=PATH=/home/epalk/.windsurf-server/bin/c855b1fa42fce019aedb4b06e6faa69d65ac7fd3:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/epalk/.windsurf-server/bin/c855b1fa42fce019aedb4b06e6faa69d65ac7fd3/node /home/epalk/projects/diary-website/backend/dist/inference/worker.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=100s
UMask=0077

# This is the only diary process allowed to reach Ollama. The API service only uses SQLite jobs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/epalk/projects/diary-website/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
