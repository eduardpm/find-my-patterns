{
  "name": "mood-pattern-diary-backend",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.18"
  },
  "description": "Mood Pattern Diary backend \u2014 API, pattern engine, and web client hosting.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../.env dist/inference/worker.js",
    "start:dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../.env dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "init-db": "node --env-file-if-exists=../.env dist/db/init.js",
    "migrate-db": "node --env-file-if-exists=../.env dist/db/migrate.js",
    "seed-example-data": "node --env-file-if-exists=../.env dist/db/seed.js",
    "backup": "node --env-file-if-exists=../.env dist/db/backup.js",
    "auth:hash-password": "node dist/auth/hash-password.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "better-sqlite3": "^12.11.1",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@swc/core": "^1.10.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "unplugin-swc": "^1.5.1",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
